# ==========================================
node_modules/
package-lock.json.bak
dist/
build/
.cache/
.parcel-cache/

# ==========================================
#  Logs & fichiers temporaires
# ==========================================
*.log
npm-debug.log*
yarn-error.log*
pids/
*.pid
tmp/
temp/

# ==========================================
#  Archives & données brutes volumineuses
# ==========================================
# Les sources géographiques téléchargées ne doivent pas être versionnées :
# elles sont volumineuses et reproductibles depuis leurs dépôts d'origine.
Desktop/Touruisme-Togo/GitHubcollect/
*.zip
*.tar
*.tar.gz
*.7z
*.rar

# ==========================================
#  Secrets & configuration locale
# ==========================================
.env
.env.*
!.env.example
*.local
*.pem
*.key

# ==========================================
#  Python (outils de traitement GeoJSON)
# ==========================================
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/

# Note : les GeoJSON réellement servis par l'application
# (Desktop/Touruisme-Togo/data/*.geojson) restent versionnés, car ils sont
# nécessaires au fonctionnement de la carte.
